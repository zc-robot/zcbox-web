{
  "name": "zc-web",
  "productName": "Zcbox",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "mock": "node ./mock/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:dev": "node scripts/electron-dev.cjs",
    "desktop:pack": "pnpm build && electron-builder --dir",
    "desktop:build": "pnpm build && electron-builder",
    "desktop:build:mac": "pnpm build && electron-builder --mac --x64 --arm64",
    "desktop:build:win": "pnpm build && electron-builder --win --x64"
  },
  "dependencies": {
    "comlink": "^4.4.1",
    "dropzone": "6.0.0-beta.2",
    "konva": "^9.0.1",
    "ky": "^0.33.3",
    "lodash": "^4.17.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone-component": "^3.2.0",
    "react-hot-toast": "^2.4.1",
    "react-konva": "18.2.7",
    "react-router-dom": "^6.14.1",
    "react-use-websocket": "^4.3.1",
    "three": "^0.184.0",
    "zustand": "^4.3.8"
  },
  "devDependencies": {
    "@antfu/eslint-config-react": "^0.39.5",
    "@iconify-json/material-symbols": "^1.1.40",
    "@types/lodash": "^4.14.195",
    "@types/node": "^18.16.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.184.1",
    "@typescript-eslint/eslint-plugin": "^5.59.9",
    "@typescript-eslint/parser": "^5.59.9",
    "@unocss/preset-attributify": "^0.51.8",
    "@unocss/preset-icons": "^0.51.8",
    "@unocss/preset-uno": "^0.51.8",
    "@unocss/transformer-variant-group": "^0.51.8",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8.42.0",
    "eslint-config-ts": "^4.0.1",
    "typescript": "^5.0.4",
    "unocss": "^0.51.8",
    "vite": "^4.3.9",
    "vite-plugin-comlink": "^3.0.5",
    "ws": "^8.13.0"
  },
  "build": {
    "appId": "com.zcbox.desktop",
    "productName": "Zcbox",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "desktop/zenoh-robot-pose-bridge.py",
      "desktop/zenoh-pointcloud-bridge.py",
      "desktop/zenoh-telemetry-bridge.py",
      "desktop/vendor/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Zcbox connects to the NEST controller and camera gateway on your local network."
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "eslintConfig": {
    "extends": [
      "@antfu/eslint-config-react"
    ],
    "rules": {
      "react/prop-types": "off",
      "react/no-unknown-property": "off"
    },
    "ignorePatterns": [
      "mock",
      "dist",
      "release",
      "desktop/vendor",
      "node_modules"
    ]
  }
}
